# Lead delivery. Without these the contact and careers forms refuse to
# submit and tell people to call instead, which is deliberate: never show
# a family a success message for a message that did not send.

# From the Resend dashboard. Set this in Vercel for Production AND Preview.
RESEND_API_KEY=

# The From header. MUST be on a domain verified in Resend.
#
# Use a SUBDOMAIN, not the root. The root domain's MX records already point
# at Proofpoint, so her real mailbox lives elsewhere; verifying the root
# means editing the existing SPF record, and an SPF record replaced rather
# than merged silently breaks her actual email. A subdomain leaves her mail
# flow completely untouched.
LEAD_FROM="Hodges Website <website@send.hodgeselderlyanddisable.com>"

# Where enquiries land. Defaults to site.email if unset.
LEAD_TO=admin@hodgeselderlyanddisable.com
