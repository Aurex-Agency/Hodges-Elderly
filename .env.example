# Lead delivery. Without these the contact and careers forms refuse to
# submit and tell people to call instead, which is deliberate: never show
# a family a success message for a message that did not send.

# From the Resend dashboard. Set in Vercel for Production and Preview only.
# Deliberately NOT set for Development: nothing consumes it there, and
# Vercel stores Development variables as readable rather than sensitive.
# Use a local .env.local for local work instead.
RESEND_API_KEY=

# The From header. MUST be on a domain verified in Resend.
#
# The verified sending domain is team.hodgeselderlyanddisable.com, a
# SUBDOMAIN, which is the right call: the root domain's MX records point at
# Proofpoint, so her real mailbox lives elsewhere. Verifying the root would
# mean editing the existing SPF record, and an SPF record replaced rather
# than merged silently breaks her actual email. The subdomain leaves her
# mail flow completely untouched.
LEAD_FROM="Hodges Website <website@team.hodgeselderlyanddisable.com>"

# Where enquiries land. Defaults to site.email if unset.
LEAD_TO=admin@hodgeselderlyanddisable.com
